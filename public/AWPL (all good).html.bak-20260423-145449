<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AWPL Price Calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --green:#1a7a3c;--green-dark:#145e2d;--green-mid:#229147;
  --green-light:#e8f5ed;--green-glow:#4caf7d;
  --gold:#d4a017;--gold-light:#f8edc0;
  --red:#c0392b;--bg:#f2f7f4;--card:#ffffff;
  --text:#1a2e22;--muted:#6b8c75;--border:#d0e6d8;
  --shadow:0 4px 24px rgba(26,122,60,0.10);--radius:16px;
  --card-bg: rgba(255,255,255,0.82);
  --card-blur: blur(10px);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;position:relative;overflow-x:hidden;}

/* ── BACKGROUND IMAGE ── */
.bg-image{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:url("data:image/jpeg;base64,");
  background-size:cover;background-position:center;
  opacity:0.22;
}
.bg-overlay{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:rgba(242,247,244,0.55);
}

/* ── HEADER ── */
.header{position:sticky;top:0;z-index:100;background:linear-gradient(135deg,var(--green-dark) 0%,var(--green) 60%,var(--green-mid) 100%);padding:0 28px;box-shadow:0 4px 20px rgba(0,0,0,.15);display:flex;align-items:center;justify-content:space-between;min-height:72px;overflow:hidden;}
.header::after{content:'';position:absolute;right:-40px;top:-30px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.05);}
.header-left{display:flex;align-items:center;gap:14px;flex:1;}
.logo-wrap{background:white;border-radius:12px;padding:5px 10px;box-shadow:0 2px 12px rgba(0,0,0,.2);display:flex;align-items:center;justify-content:center;min-width:100px;}
.logo-wrap img{height:40px;display:block;object-fit:contain;}
.fallback-logo{font-family:'Nunito',sans-serif;font-size:1.5rem;font-weight:900;color:var(--green);letter-spacing:-1px;display:none;}
.header-title{flex:1;}
.header-title h1{font-family:'Nunito',sans-serif;font-size:1.22rem;font-weight:900;color:white;letter-spacing:.3px;margin:0;}
.header-title p{font-size:.72rem;color:rgba(255,255,255,.75);margin-top:2px;margin:0;margin-top:2px;}
/* header-right kept but empty — no share button in header */
.header-right{display:flex;align-items:center;gap:10px;position:relative;z-index:2;}

/* ── LAYOUT ── */
.main{position:relative;z-index:1;display:grid;grid-template-columns:340px 1fr;gap:20px;max-width:1280px;margin:22px auto;padding:0 20px 100px;align-items:start;}
.left-panel{position:sticky;top:16px;}

/* ── GLASS CARDS ── */
.search-card,.summary-card,.products-card{
  background:var(--card-bg);
  backdrop-filter:var(--card-blur);
  -webkit-backdrop-filter:var(--card-blur);
  border:1px solid rgba(255,255,255,0.7);
}
.search-card{position:relative;z-index:60;border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);margin-bottom:16px;}
.search-card h3{font-size:.8rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;}
.search-wrap{position:relative;}
#searchInput{width:100%;padding:10px 12px 10px 36px;border:2px solid var(--border);border-radius:10px;font-size:.88rem;font-family:'Poppins',sans-serif;outline:none;transition:border-color .2s;background:rgba(250,255,254,0.85);color:var(--text);}
#searchInput:focus{border-color:var(--green);}
.s-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);pointer-events:none;font-size:.95rem;}
#categoryFilter{width:100%;margin-top:10px;padding:9px 12px;border:2px solid var(--border);border-radius:10px;font-size:.85rem;font-family:'Poppins',sans-serif;background:rgba(250,255,254,0.85);color:var(--text);outline:none;cursor:pointer;}
#categoryFilter:focus{border-color:var(--green);}
.dropdown{position:absolute;left:0;right:0;top:calc(100% + 6px);background:rgba(255,255,255,0.96);border:1px solid var(--border);border-radius:12px;max-height:260px;overflow-y:auto;z-index:999;box-shadow:0 8px 30px rgba(0,0,0,.14);display:none;backdrop-filter:blur(8px);}
.dropdown-item{padding:10px 14px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f0f5f2;transition:background .15s;}
.dropdown-item:last-child{border-bottom:none;}
.dropdown-item:hover{background:var(--green-light);}
.di-name{font-size:.83rem;font-weight:600;color:var(--text);}
.di-cat{font-size:.7rem;color:var(--muted);margin-top:2px;}
.di-dp{font-size:.82rem;font-weight:800;color:var(--green);}

/* ── SUMMARY CARD ── */
.summary-card{border-radius:var(--radius);padding:20px;box-shadow:0 8px 32px rgba(26,122,60,.28);color:white;position:relative;overflow:hidden;background:linear-gradient(160deg,rgba(20,94,45,0.92) 0%,rgba(26,122,60,0.88) 100%) !important;border:1px solid rgba(255,255,255,0.25) !important;}
.summary-card::before{content:'';position:absolute;right:-30px;bottom:-30px;width:150px;height:150px;border-radius:50%;background:rgba(255,255,255,.06);}
.summary-card::after{content:'';position:absolute;left:-20px;top:-20px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.04);}
.summary-title{font-family:'Nunito',sans-serif;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;opacity:.8;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative;z-index:1;}
.s-tile{background:rgba(255,255,255,.12);border-radius:12px;padding:12px;text-align:center;border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(4px);}
.s-tile.gold{background:rgba(212,160,23,.28);border-color:rgba(212,160,23,.4);}
.s-tile.full{grid-column:1/-1;}
.s-tile .s-label{font-size:.68rem;opacity:.78;letter-spacing:.5px;text-transform:uppercase;margin-bottom:5px;}
.s-tile .s-value{font-family:'Nunito',sans-serif;font-size:1.55rem;font-weight:900;line-height:1;}
.s-tile .s-sub{font-size:.68rem;opacity:.65;margin-top:3px;}
.divider-line{height:1px;background:rgba(255,255,255,.15);margin:14px 0;position:relative;z-index:1;grid-column:1/-1;}
.clear-row{display:flex;justify-content:flex-end;margin-top:12px;position:relative;z-index:1;}
.clear-btn{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);color:white;padding:5px 14px;border-radius:20px;font-size:.74rem;font-weight:600;cursor:pointer;font-family:'Poppins',sans-serif;transition:all .2s;}
.clear-btn:hover{background:rgba(192,57,43,.5);border-color:rgba(192,57,43,.6);}

/* ── PRODUCTS CARD ── */
.products-card{border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);position:relative;}
.products-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.products-header h2{font-family:'Nunito',sans-serif;font-size:1.1rem;font-weight:900;color:var(--text);}
.item-count{font-size:.75rem;background:var(--green-light);color:var(--green);padding:3px 10px;border-radius:20px;font-weight:700;}
.cart-table{width:100%;border-collapse:collapse;}
.cart-table th{font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;padding:8px 10px;border-bottom:2px solid var(--border);text-align:left;background:rgba(232,245,237,0.7);}
.cart-table th:first-child{border-radius:8px 0 0 0;}
.cart-table th:last-child{border-radius:0 8px 0 0;text-align:center;}
.cart-table td{padding:11px 10px;border-bottom:1px solid rgba(240,245,242,0.8);font-size:.85rem;vertical-align:middle;}
.cart-table tr:last-child td{border-bottom:none;}
.cart-table tr:hover td{background:rgba(250,255,254,0.7);}
.prod-name-main{font-weight:700;font-size:.86rem;color:var(--text);line-height:1.3;}
.cat-badge{display:inline-block;margin-top:3px;font-size:.67rem;padding:2px 8px;border-radius:20px;font-weight:700;background:var(--green-light);color:var(--green);}
.price-col{font-size:.8rem;color:var(--muted);}
.price-col b{color:var(--green);font-size:.88rem;}
.dp-total{font-weight:800;font-size:.95rem;color:var(--green-dark);}
.mrp-total{color:var(--muted);font-size:.8rem;text-decoration:line-through;}
.sp-val{font-size:.85rem;color:var(--gold);font-weight:800;text-align:center;letter-spacing:-.2px;}
.qty-ctrl{display:flex;align-items:center;gap:6px;}
.qty-btn{width:26px;height:26px;border-radius:50%;border:2px solid var(--green);background:white;color:var(--green);font-size:1.1rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;line-height:1;}
.qty-btn:hover{background:var(--green);color:white;}
.qty-val{font-weight:800;color:var(--text);min-width:22px;text-align:center;font-size:.95rem;}
.remove-btn{background:none;border:none;color:#ccc;cursor:pointer;font-size:1rem;padding:3px 7px;border-radius:6px;transition:all .2s;}
.remove-btn:hover{color:var(--red);background:#ffeeed;}

/* ── PRODUCT CARD (bottom-right of right panel) ── */
.product-info-card{
  margin-top:14px;
  display:flex;
  justify-content:flex-end;
}
.pic-inner{
  background:linear-gradient(135deg,rgba(0, 0, 0, 0.92),rgba(34,145,71,0.88));
  border-radius:14px;
  padding:12px 18px;
  color:white;
  min-width:260px;
  max-width:340px;
  box-shadow:0 6px 24px rgba(26,122,60,.3);
  border:1px solid rgba(255,255,255,.2);
  backdrop-filter:blur(8px);
  display:flex;flex-direction:column;gap:6px;
}
.pic-title{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;opacity:.75;margin-bottom:2px;}
.pic-row{display:flex;justify-content:space-between;align-items:center;gap:12px;}
.pic-stat{text-align:center;}
.pic-stat .ps-val{font-family:'Nunito',sans-serif;font-size:1.25rem;font-weight:900;line-height:1;}
.pic-stat .ps-lbl{font-size:.62rem;opacity:.7;letter-spacing:.4px;text-transform:uppercase;margin-top:1px;}
.pic-divider{width:1px;background:rgba(255,255,255,.25);align-self:stretch;}
.pic-website{font-size:.65rem;opacity:.55;text-align:right;margin-top:2px;}

/* ── EMPTY STATE ── */
.empty-state{text-align:center;padding:50px 20px;color:var(--muted);}
.empty-icon{font-size:3rem;margin-bottom:12px;}
.empty-state p{font-size:.88rem;}

/* ── FLOATING SHARE BUTTON ── */
.float-share{
  position:fixed;bottom:30px;right:30px;z-index:1000;
  display:flex;align-items:center;gap:9px;
  background:linear-gradient(135deg,var(--green-dark),var(--green-mid));
  color:white;border:none;
  padding:14px 22px;border-radius:50px;
  font-size:.88rem;font-weight:700;cursor:pointer;
  box-shadow:0 6px 28px rgba(26,122,60,.45);
  font-family:'Poppins',sans-serif;
  transition:all .25s;
  border:1px solid rgba(255,255,255,.2);
}
.float-share:hover{transform:translateY(-3px);box-shadow:0 10px 36px rgba(26,122,60,.55);}
.float-share .fs-icon{font-size:1.1rem;}
.float-badge{background:var(--gold);color:#fff;font-size:.7rem;font-weight:800;padding:2px 8px;border-radius:20px;min-width:22px;text-align:center;}

/* ── MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:white;border-radius:20px;padding:28px;width:90%;max-width:500px;box-shadow:0 20px 60px rgba(0,0,0,.3);animation:modalIn .25s ease;}
@keyframes modalIn{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
.modal-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;}
.modal-top h2{font-family:'Nunito',sans-serif;font-size:1.2rem;font-weight:900;color:var(--text);}
.modal-sub{font-size:.8rem;color:var(--muted);margin-bottom:18px;}
.modal-close{background:none;border:none;font-size:1.3rem;cursor:pointer;color:var(--muted);}
.share-preview{background:var(--green-light);border:1px solid var(--border);border-radius:12px;padding:16px;font-size:.78rem;color:var(--text);white-space:pre-wrap;max-height:220px;overflow-y:auto;font-family:monospace;line-height:1.6;margin-bottom:16px;}
.share-btns{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.share-action{padding:12px;border-radius:12px;font-size:.85rem;font-weight:700;cursor:pointer;border:none;font-family:'Poppins',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s;}
.sa-copy{background:var(--green);color:white;}
.sa-copy:hover{background:var(--green-dark);}
.sa-wa{background:#256dd3;color:white;}
.sa-wa:hover{background:#1da850;}

/* ── TOAST ── */
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--green-dark);color:white;padding:10px 24px;border-radius:50px;font-size:.85rem;font-weight:600;opacity:0;transition:all .3s;z-index:99999;pointer-events:none;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ── RESPONSIVE ── */
/* TABLET (600px - 900px) */
@media(min-width:600px) and (max-width:900px){
  :root{
    --green:#0d6a3f;--green-dark:#0a4d2c;--green-mid:#1a8a52;
    --gold:#c4941a;--bg:#f5f9f7;
  }
  .main{grid-template-columns:1fr;padding:20px 12px;padding-bottom:100px;}
  .left-panel{position:static;margin-bottom:20px;}
  .right-panel{order:-1;}
  .search-card{padding:16px;margin-bottom:14px;}
  .summary-title{font-size:.75rem;}
  .s-value{font-size:1.35rem !important;}
  .products-header h2{font-size:1rem;}
  .cart-table th{font-size:.68rem;padding:7px 8px;}
  .cart-table td{padding:10px 8px;font-size:.82rem;}
  .float-share{bottom:18px;right:18px;padding:11px 16px;font-size:.80rem;}
  .float-badge{font-size:.65rem;padding:2px 6px;}
  .product-info-card{margin-top:12px;}
  .pic-inner{min-width:240px;max-width:310px;padding:10px 14px;}
}

/* MOBILE (< 600px) */
@media(max-width:599px){
  :root{
    --green:#0d6a3f;--green-dark:#0a4d2c;--green-mid:#1a8a52;
    --gold:#c4941a;--red:#b8291a;--bg:#fafbf9;
    --card:#ffffff;--text:#0a1810;--muted:#556b60;
    --border:#c5dfd2;--shadow:0 2px 12px rgba(13,106,63,0.08);
  }
  *{box-sizing:border-box;}
  body{font-size:14px;min-height:100vh;}
  
  header{padding:12px 14px;gap:8px;}
  .logo-wrap img{height:36px;}
  .logo-wrap{width:40px;height:40px;}
  .fallback-logo{font-size:.95rem;line-height:40px;}
  header .header-left{gap:10px;}
  .header-title h1{font-size:.95rem;font-weight:800;}
  .header-title p{display:none !important;}
  
  .main{grid-template-columns:1fr;padding:14px;padding-bottom:110px;gap:12px;}
  .left-panel{position:static;}
  .right-panel{order:-1;}
  
  .search-card{padding:14px;margin-bottom:12px;border-radius:12px;}
  .search-card h3{font-size:.7rem;margin-bottom:10px;}
  #searchInput{padding:10px 10px 10px 32px;font-size:.85rem;border-radius:8px;}
  .s-icon{left:10px;font-size:.85rem;}
  #categoryFilter{margin-top:8px;padding:9px 10px;font-size:.8rem;border-radius:8px;}
  .dropdown{max-height:220px;border-radius:10px;top:calc(100% + 4px);}
  .dropdown-item{padding:10px 12px;font-size:.8rem;}
  .di-name{font-size:.8rem;}
  .di-cat{font-size:.65rem;}
  .di-dp{font-size:.8rem;}
  
  .summary-card{border-radius:12px;padding:16px;box-shadow:0 4px 16px rgba(13,106,63,0.12);}
  .summary-title{font-size:.7rem;margin-bottom:14px;gap:6px;}
  .summary-grid{gap:8px;}
  .s-tile{padding:10px;border-radius:10px;border:1px solid rgba(13,106,63,0.12);}
  .s-label{font-size:.63rem;}
  .s-value{font-family:'Nunito',sans-serif;font-size:1.1rem;font-weight:900;}
  .s-sub{font-size:.60rem;margin-top:2px;}
  .clear-btn{padding:5px 12px;font-size:.70rem;border-radius:16px;}
  
  .products-card{border-radius:12px;padding:16px;box-shadow:0 2px 12px rgba(13,106,63,0.08);}
  .products-header{margin-bottom:14px;gap:8px;}
  .products-header h2{font-size:.95rem;font-weight:800;}
  .item-count{font-size:.65rem;padding:3px 8px;border-radius:16px;}
  
  .cart-table th{font-size:.65rem;padding:6px 7px;letter-spacing:.3px;}
  .cart-table td{padding:9px 7px;font-size:.78rem;vertical-align:middle;}
  .prod-name-main{font-size:.80rem;font-weight:700;}
  .cat-badge{font-size:.62rem;padding:2px 6px;}
  .price-col{font-size:.75rem;}
  .price-col b{font-size:.82rem;}
  .dp-total{font-size:.90rem;}
  .mrp-total{font-size:.72rem;}
  .sp-val{font-size:.80rem;}
  
  .qty-btn{width:24px;height:24px;border-width:1.5px;font-size:.95rem;}
  .qty-val{font-size:.85rem;min-width:20px;}
  .remove-btn{font-size:.9rem;padding:2px 5px;}
  
  .product-info-card{margin-top:12px;justify-content:center;}
  .pic-inner{min-width:100%;max-width:100%;padding:10px 12px;}
  .pic-title{font-size:.65rem;margin-bottom:8px;}
  .pic-row{gap:8px;}
  .pic-stat .ps-val{font-size:1.1rem;}
  .pic-stat .ps-lbl{font-size:.57rem;}
  .pic-divider{display:none;}
  .pic-website{font-size:.60rem;margin-top:6px;}
  
  .empty-state{padding:40px 14px;text-align:center;}
  .empty-icon{font-size:2.5rem;margin-bottom:10px;}
  .empty-state p{font-size:.80rem;}
  
  .float-share{position:fixed;bottom:14px;right:14px;padding:10px 14px;font-size:.75rem;border-radius:24px;gap:6px;}
  .float-badge{font-size:.60rem;padding:2px 5px;min-width:20px;}
  .fs-icon{font-size:.95rem;}
  
  .modal{width:92%;max-width:95%;padding:20px;border-radius:16px;}
  .modal-top h2{font-size:1.05rem;}
  .modal-sub{font-size:.75rem;}
  .share-preview{padding:12px;font-size:.72rem;max-height:180px;border-radius:10px;}
  .share-btns{gap:8px;}
  .share-action{padding:10px;font-size:.78rem;border-radius:10px;gap:6px;}
  
  .toast{bottom:80px;font-size:.78rem;padding:8px 16px;border-radius:20px;}
  
  /* TABLE RESPONSIVE */
  .cart-table th:nth-child(2),.cart-table td:nth-child(2){display:none;}
  .cart-table th:nth-child(3){border-radius:6px 0 0 0;}
  .cart-table th:nth-child(5){border-radius:0 6px 0 0;}
}

/* SMALL MOBILE (< 400px) */
@media(max-width:399px){
  :root{
    --green:#0d6a3f;--green-dark:#0a4d2c;
    --gold:#c4941a;--shadow:0 2px 8px rgba(13,106,63,0.06);
  }
  header{padding:10px 10px;}
  .logo-wrap{width:36px;height:36px;}
  .logo-wrap img{height:32px;}
  .fallback-logo{font-size:.85rem;line-height:36px;}
  .header-title h1{font-size:.85rem;}
  
  .main{padding:10px;padding-bottom:100px;gap:10px;}
  .search-card{padding:12px;margin-bottom:10px;}
  .search-card h3{font-size:.65rem;}
  #searchInput{padding:9px 9px 9px 30px;font-size:.80rem;}
  .s-icon{left:9px;font-size:.80rem;}
  
  .summary-card{padding:14px;border-radius:10px;}
  .summary-title{font-size:.65rem;}
  .s-value{font-size:.95rem !important;}
  .s-label{font-size:.58rem;}
  .s-sub{font-size:.55rem;}
  
  .products-card{padding:14px;}
  .products-header h2{font-size:.85rem;}
  .item-count{font-size:.58rem;}
  
  .cart-table th{font-size:.60rem;padding:5px 5px;}
  .cart-table td{padding:8px 5px;font-size:.72rem;}
  .prod-name-main{font-size:.75rem;}
  .price-col{font-size:.68rem;}
  
  .qty-btn{width:22px;height:22px;font-size:.85rem;}
  .float-share{padding:8px 12px;font-size:.68rem;}
  .float-badge{font-size:.55rem;padding:1px 4px;}
  
  .pic-inner{padding:8px 10px;}
  .pic-stat .ps-val{font-size:.95rem;}
}

/* LANDSCAPE MOBILE */
@media(max-width:899px) and (orientation:landscape){
  body{overflow-y:auto;}
  header{padding:8px 10px;}
  .header-title p{display:none !important;}
  .main{padding:8px;gap:8px;}
  .summary-grid{grid-template-columns:1fr 1fr 1fr;}
  .s-value{font-size:.95rem !important;}
